# --- Database (local Docker SQL Server) ---------------------------------------
# Required: choose your own. SQL Server complexity rules apply (8+ chars with upper, lower, digit and symbol).
# docker compose refuses to start while any of these is empty.
MSSQL_SA_PASSWORD=
SALES_DB_PASSWORD=
MGMT_DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=14333
DB_NAME=SouthCity
DB_QUERY_TIMEOUT_S=5

# --- LLM (any OpenAI-compatible chat completions endpoint) ---------------------
# Tested with Moonshot Kimi. Examples:
#   Moonshot: LLM_BASE_URL=https://api.moonshot.ai/v1   LLM_MODEL=kimi-k2.6
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k2.6
LLM_TIMEOUT_S=60

# --- API auth -------------------------------------------------------------------
# demo    : trust the user_role sent by the caller (what the test README asks for)
# api_key : role comes from the API key; a conflicting user_role is rejected
AUTH_MODE=demo
# JSON object mapping API key -> role, used only when AUTH_MODE=api_key
API_KEYS={}
